---
import { course } from "../components/school/course";
import Base from "../layouts/Base.astro";
import "../styles/page.css";
import { mascotSVG, SPECIES, WORKS_LINE } from "../lib/ui/mascot";
import { BROKEN_LINE } from "../lib/ui/coopbirds";
import { PRESETS } from "../lib/ui/recipe";
import { meta, methods, lessons, experiments, FAMILY_ORDER } from "../lib/lab/data";
import { labRedirectScript } from "../lib/ui/labroutes";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Every count is read at build time: the lab data, the test set, and Flight School's course.
const testsets = import.meta.glob<{ images: unknown[] }>("/public/testset/testset.json", { eager: true, import: "default" });
const photos = Object.values(testsets)[0]?.images?.length;
if (!photos) throw new Error("public/testset/testset.json is missing or has no images");

const allMethods = methods();
const runnable = allMethods.filter((m) => m.status === "runnable").length;
const categories = Object.values(meta().categories).map((c) => c.toLowerCase());
const allLessons = lessons();
const exps = experiments();
const expGroups = new Set(exps.map((e) => e.group)).size;
const chapters = course();
const COURSE_CHAPTERS = chapters.length;
const UNFINISHED = chapters.filter((c) => c.gap).length;


const and = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

const presets = PRESETS.filter((p) => p.id !== "fp32");
const mixed = PRESETS.find((p) => p.id === "mixed");
if (!mixed) throw new Error("index: the Coop's mixed-precision preset is missing");
// Recorded, not measured on this page: the Mixed precision preset's row in docs/findings-pigeon.md
// ("In the browser"), the smallest healthy Pigeon on record.
const RECORDED = { kb: 737, ratio: 5.0, accuracy: "94.4", pointing: "98.0" };

// The key to the birds: each drawn at the compression ratio where a model becomes it. A species
// smaller than the recorded best is marked: the size exists, but no healthy Pigeon has reached it.
const ladder = SPECIES.map((sp) => ({
  sp,
  svg: mascotSVG({ ratio: Math.max(1, sp.minRatio), accuracy: 0.95, pointing: 0.98 }).svg,
  size: sp.minRatio > 0 ? `≥ ${sp.minRatio}× smaller` : "uncompressed",
  reached: sp.minRatio <= RECORDED.ratio,
}));
const bones = mascotSVG({ ratio: 4, accuracy: 0.5, pointing: 0.2 }).svg;
const reachedName = [...ladder].reverse().find((b) => b.reached)!.sp.name;
const unreached = ladder.filter((b) => !b.reached).map((b) => b.sp);
const guideName = (id: string) => {
  const m = allMethods.find((x) => x.id === id);
  if (!m) throw new Error(`index: no Field Guide method "${id}"`);
  return m.name;
};

const redirect = labRedirectScript(
  { methods: allMethods.map((m) => m.id), families: FAMILY_ORDER, lessons: allLessons.map((l) => l.id), experiments: exps.map((e) => e.name) },
  { base, fallback: null, strict: true },
);
---
<Base title="Pigeon · a field guide to model compression" description="Learn model compression by shrinking a real bird-spotting model in your browser.">
  <script is:inline set:html={redirect}></script>
  <main id="main" class="page home">
    <header class="lead">
      <h1>Shrink a real model with your own hands, and watch what it costs.</h1>
      <p class="lede">Pigeon is a small image model with one job: <em>is there a bird, and where?</em> Quantize it, prune it, palettize it, right here in your browser, on {photos} real photos. Keep it accurate and it slims from a rock pigeon to a common swift. Push further with these tools, which never retrain it, and it starves.</p>
      <div class="cta">
        <a class="btn" href={`${base}coop/`}>Open the Coop</a>
        <a class="btn secondary" href={`${base}school/`}>Start Flight School</a>
      </div>
    </header>

    <section class="flagship" aria-labelledby="coop-title">
      <h2 id="coop-title">The Coop</h2>
      <p class="intro">Where the shrinking happens. Stack quantization, pruning and palettes into a recipe. After every change Pigeon scores itself again on all {photos} photos and shows what it cost: accuracy, pointing, and the real size in bytes. The Coop's second cage holds <a href={`${base}coop/yolo/`}>YOLOv8n</a>, a real detector that draws a box around every bird it finds. Its tools are its own: one precision for all its weights, and a channel cut for each stage. It is scored on the same {photos} photos, and its health is the share of its bird-finding AP it keeps.</p>

      <figure class="ladder">
        <ol class="birds">
          {ladder.map(({ sp, svg, size, reached }) => (
            <li>
              <div class="svg" aria-hidden="true" set:html={svg} />
              <p class="bird-name">{sp.name}</p>
              <p class="bird-latin">{sp.latin}</p>
              <p class="bird-size num"><span>{size}</span><span>{sp.grams} g</span></p>
              {!reached && <p class="bird-reach">No healthy Pigeon this small yet</p>}
            </li>
          ))}
          <li class="dead">
            <div class="svg" aria-hidden="true" set:html={bones} />
            <p class="bird-name">Skeleton</p>
            <p class="bird-size"><span>pushed too far:</span><span>it's guessing</span></p>
          </li>
        </ol>
        <figcaption>
          <p>The key to sizes: how much smaller a model gets decides which bird it becomes. Pigeon stays healthy while it keeps {WORKS_LINE} (its heatmap lands on the real bird). Below that it starves, and it is bones at {BROKEN_LINE}.</p>
          <p>
            The smallest healthy Pigeon on record is a {reachedName}: the {mixed.name} preset, {RECORDED.kb} KB, {RECORDED.ratio.toFixed(2)} times smaller, with {RECORDED.accuracy}% accuracy and {RECORDED.pointing}% pointing (recorded in the lab's notes, not measured on this page).
            No recipe on record keeps it healthy at {unreached[0].minRatio} times smaller or more, where the {unreached[0].name} starts. That probably takes retraining, which the Coop's tools never do;
            the Field Guide's <a href={`${base}guide/qat/`}>{guideName("qat")}</a> and <a href={`${base}guide/kd/`}>{guideName("kd")}</a> show how it works on the lab's small models.
          </p>
          <p>Every bird you hatch, in either cage or in a Field Guide run, is kept on your <a href={`${base}life-list/`}>life list</a>.</p>
        </figcaption>
      </figure>

      <h3 id="presets-title">Open the Coop with a preset loaded</h3>
      <ul class="presets" aria-labelledby="presets-title">
        {presets.map((p) => (
          <li>
            <a href={`${base}coop/?preset=${p.id}`}><span class="preset-name">{p.name}</span><span class="preset-hint">{p.hint}</span></a>
          </li>
        ))}
      </ul>
    </section>

    <section class="more" aria-labelledby="more-title">
      <h2 id="more-title">Lessons, methods, experiments and your birds</h2>
      <ul class="entries">
        <li>
          <a class="entry" href={`${base}school/`}>
            <span class="name">Flight School</span>
            <span class="aside num">{allLessons.length} coding lessons</span>
            <span class="summary">Write the core of a method yourself in Python, then check it against tests, all in your browser. Plus a {COURSE_CHAPTERS}-chapter course on the building blocks that reads through the Field Guide; {UNFINISHED} of its chapters still have gaps, and each says what is missing.</span>
          </a>
        </li>
        <li>
          <a class="entry" href={`${base}guide/`}>
            <span class="name">Field Guide</span>
            <span class="aside num">{allMethods.length} methods</span>
            <span class="summary">One write-up per method, grouped by what it does: {and(categories)}. {runnable} of them run in your browser.</span>
          </a>
        </li>
        <li>
          <a class="entry" href={`${base}results/`}>
            <span class="name">Results</span>
            <span class="aside num">{exps.length} experiments</span>
            <span class="summary">Simulations in {expGroups} groups, each asking one question about compression, with its figures, its numbers, and a report on what they show.</span>
          </a>
        </li>
        <li>
          <a class="entry" href={`${base}life-list/`}>
            <span class="name">Life list</span>
            <span class="aside">kept in your browser</span>
            <span class="summary">Every bird you hatch in the Coop's two cages and in Field Guide runs, the way a birder keeps a life list: each species once, at its best sighting, with the recipe that made it.</span>
          </a>
        </li>
      </ul>
    </section>
  </main>

  <style>
    .home { gap: var(--space-7); }
    .lead { display: flex; flex-direction: column; gap: var(--space-4); max-width: var(--measure); }
    .home h1 { font-size: var(--step-4); }
    .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
    /* A real hover on both calls to action: the label underlines, and the secondary one takes the action color. */
    .cta .btn:hover { text-decoration: underline; text-underline-offset: 3px; }
    .cta .btn.secondary:hover { color: var(--teal); }

    /* The Coop is the flagship: a heavy ink rule, the larger heading, and the birds on a plate.
       Headings sit in a left margin column, like the entry headings of a printed guide. */
    .flagship {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-5) var(--space-6);
      border-top: 2px solid var(--ink); padding-top: var(--space-4);
    }
    .flagship h2 { font-size: var(--step-3); }
    .flagship h3 { font-size: var(--step-1); }
    .intro { font-size: var(--step-1); max-width: var(--measure); }

    .ladder { grid-column: 1 / -1; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
    /* Every bird is drawn in the same frame, so top-aligned frames share one ground line and the sizes compare honestly. */
    .birds {
      list-style: none; margin: 0; padding: var(--space-4); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-4) var(--space-3); align-items: start; background: var(--card); border: 1px solid var(--rule);
    }
    .birds li { display: flex; flex-direction: column; gap: var(--space-1); }
    .birds .svg :global(svg) { width: 100%; height: auto; display: block; }
    .bird-name { font-family: var(--display); font-weight: 600; font-size: var(--step-0); line-height: 1.2; }
    .bird-latin { font-family: var(--display); font-style: italic; color: var(--magenta); font-size: var(--step--1); line-height: 1.3; }
    .bird-size { font-family: var(--mono); font-size: var(--step--2); color: var(--muted); display: flex; flex-direction: column; }
    .dead .bird-name { color: var(--bad); }
    /* An honest gap in the key: the size exists, Pigeon hasn't reached it healthy. */
    .bird-reach { font-size: var(--step--2); font-style: italic; color: var(--muted); line-height: 1.3; }
    .ladder figcaption { font-size: var(--step--1); color: var(--muted); max-width: var(--measure); display: flex; flex-direction: column; gap: var(--space-2); }

    .presets {
      list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
      column-gap: var(--space-5); border-top: 1px solid var(--rule); align-content: start;
    }
    .presets li { border-bottom: 1px solid var(--rule); }
    .presets a {
      display: flex; flex-direction: column; gap: var(--space-1); min-height: var(--tap);
      padding: var(--space-3) var(--space-1); text-decoration: none; color: var(--ink);
    }
    .preset-name { color: var(--teal); font-weight: 600; }
    .preset-hint { font-size: var(--step--1); color: var(--muted); }
    .presets a:hover .preset-name { text-decoration: underline; text-underline-offset: 2px; }

    .more { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-3) var(--space-6); border-top: 1px solid var(--rule); padding-top: var(--space-4); }
    .more h2 { font-size: var(--step-2); }

    @media (max-width: 860px) {
      .flagship, .more { grid-template-columns: minmax(0, 1fr); }
      .birds { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .home { gap: var(--space-6); }
      .home h1 { font-size: var(--step-3); }
      .intro { font-size: var(--step-0); }
      .birds { padding: var(--space-3); gap: var(--space-4) var(--space-2); }
      .cta .btn { flex: 1 1 auto; }
    }
    /* Narrow phones: two birds a row, so "Ruby-throated Hummingbird" fits its column. */
    @media (max-width: 480px) {
      .birds { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</Base>
