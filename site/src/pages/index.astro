---
import Base from "../layouts/Base.astro";
import { mascotSVG } from "../lib/ui/mascot";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const ladder = [1, 2, 4, 8, 16].map((r) => mascotSVG({ ratio: r, accuracy: 0.95, pointing: 0.98 }));
const bones = mascotSVG({ ratio: 4, accuracy: 0.5, pointing: 0.2 });
---
<Base title="Pigeon" active={undefined}>
  <main class="home">
    <section class="lead">
      <p class="label">A field guide to model compression</p>
      <h1>Shrink a real model with your own hands, and watch what it costs.</h1>
      <p class="sub">Pigeon is a small image model with one job: <em>is there a bird, and where?</em> Quantize it, prune it, palettize it, right here in your browser, on 500 real photos. Keep it accurate and it slims from a pigeon into a hummingbird. Push too far and it starves.</p>
      <div class="cta"><a class="go" href={`${base}coop/`}>Open the Coop</a><a class="alt" href={`${base}school/`}>Preview the Flight School syllabus</a></div>
    </section>

    <section class="ladder" aria-label="The species ladder">
      {ladder.map((m, i) => (
        <figure>
          <div class="svg" set:html={m.svg} />
          <figcaption><strong>{m.species.name}</strong><span class="num">{[1, 2, 4, 8, 16][i]}× smaller · {m.species.grams} g</span></figcaption>
        </figure>
      ))}
      <figure class="dead">
        <div class="svg" set:html={bones.svg} />
        <figcaption><strong>Too far</strong><span>accuracy gone</span></figcaption>
      </figure>
    </section>

    <section class="three">
      <a href={`${base}school/`}><h2>Flight School</h2><p class="state">Coming next</p><p>Twelve short lessons on the building blocks: number formats, scales, bits, outliers, pruning, distillation. The syllabus is posted; the lessons are still being written. Until then, the Lab has ten build-it-yourself coding lessons.</p></a>
      <a href={`${base}coop/`}><h2>The Coop</h2><p class="state open">Open now</p><p>A sandbox. Stack methods, watch accuracy and size move live, and find the smallest Pigeon that still works.</p></a>
      <a href={`${base}guide/`}><h2>Field Guide</h2><p class="state">Coming next</p><p>The compression techniques people use in 2026, from INT8 to GGUF k-quants to NVFP4. The list is posted; the write-ups and code for your own models are on the way. Until then, the Lab has runnable write-ups for 43 methods.</p></a>
    </section>
  </main>
  <style>
    .home { max-width: 1100px; margin: 0 auto; padding-inline: 20px; padding-block: 48px 72px; display: flex; flex-direction: column; gap: 48px; }
    .lead { display: flex; flex-direction: column; gap: 14px; max-width: 68ch; }
    .lead h1 { font-size: clamp(2rem, 5vw, var(--step-4)); }
    .sub { font-size: 1.1rem; color: var(--muted); }
    .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .go, .alt { padding: 10px 18px; text-decoration: none; border-radius: var(--radius); font-weight: 600; }
    .go { background: var(--teal); color: var(--paper); }
    .alt { border: 1px solid var(--rule); color: var(--ink); }
    .ladder { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; align-items: end; border-block: 1px solid var(--rule); padding-block: 12px; }
    .ladder figure { margin: 0; display: flex; flex-direction: column; gap: 4px; }
    .ladder .svg :global(svg) { width: 100%; height: auto; display: block; }
    .ladder figcaption { display: flex; flex-direction: column; font-size: 0.8rem; line-height: 1.3; }
    .ladder figcaption span { color: var(--muted); font-family: var(--mono); font-size: 0.7rem; }
    .dead figcaption strong { color: var(--bad); }
    .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .three a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); border-top: 2px solid var(--ink); padding-top: 12px; }
    .three a:hover h2 { color: var(--teal); }
    .three h2 { font-size: var(--step-2); }
    .three p { color: var(--muted); font-size: 0.95rem; }
    .three .state { font-size: 0.85rem; font-style: italic; margin-top: -4px; }
    .three .state.open { color: var(--teal); }
    @media (max-width: 760px) {
      .ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .three { grid-template-columns: 1fr; }
    }
  </style>
</Base>
