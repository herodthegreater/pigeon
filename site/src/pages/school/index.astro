---
import Base from "../../layouts/Base.astro";
import "../../styles/page.css";
import { lessons, methods } from "../../lib/lab/data";
import { CHECK_LIMIT_S } from "../../lib/lab/python";
import { course, lessonHref } from "../../components/school/course";

const chapters = course();
const all = lessons();
const names = new Map(methods().map((m) => [m.id, m.name]));
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base
  title="Flight School · Pigeon"
  active="school"
  description={`A ${chapters.length}-chapter reading map through model compression, plus ${all.length} coding lessons you check in your browser.`}
>
  <main id="main" class="page">
    <header>
      <h1>Flight School</h1>
      <p class="lede">
        Today Flight School is a reading map: {chapters.length} chapters in order, each pointing to
        the <a href={`${base}guide/`}>Field Guide</a> write-ups that teach it, plus {all.length} coding lessons where
        you build the algorithms yourself. Some
        chapters aren't fully written yet, and those say what's missing.
      </p>
    </header>

    <section class="group" aria-labelledby="course">
      <h2 id="course">The course</h2>
      <p>
        Each chapter lists the sections to read, the lesson that codes the idea, and, where it fits, a preset that
        loads it onto Pigeon's real weights in the Coop.
      </p>
      <ol class="course" role="list">
        {chapters.map((c) => (
          <li class="chapter">
            <span class="n num" aria-hidden="true">{c.n}</span>
            <div class="head">
              <h3><span class="visually-hidden">Chapter {c.n}: </span>{c.title}</h3>
              <p class="sub">{c.subtitle}</p>
            </div>
            <div class="reading">
              {c.links.length > 0 && (
                <ul role="list">
                  {c.links.map((l) => (
                    <li class={l.kind}><a href={l.href}>{l.label}</a></li>
                  ))}
                </ul>
              )}
              {c.gap && <p class="gap">{c.gap}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="group" aria-labelledby="build">
      <h2 id="build">Build it yourself</h2>
      <p>
        Write the pieces of compression in plain numpy, from softmax to GPTQ's error-compensation loop. Each lesson
        gives you starting code and runs hidden tests against yours: gradient checks, comparisons with the lab's own
        implementation, or a model that has to reach an accuracy.
      </p>
      <p>
        Your code runs in your own browser (Python compiled to WebAssembly), with a {CHECK_LIMIT_S}-second limit
        per check. Nothing is sent to a server, and drafts are saved in this browser.
      </p>
      <p class="progress" data-progress data-total={all.length} hidden></p>
      <ul class="entries">
        {all.map((l) => (
          <li>
            <a class="entry" href={lessonHref(l.id)}>
              <span class="name">{l.title}</span>
              <span class="aside passed" data-passed={l.id} hidden>Passed</span>
              {l.methods.length > 0 && (
                <span class="summary">Used in: {l.methods.map((m) => names.get(m) ?? m).join(", ")}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style>
  .group + .group { margin-top: var(--space-5); }

  /* The course: a numbered index, like a field guide's plate list. Number, then
     the chapter's name and subtitle, then what to read. */
  .course { list-style: none; margin: var(--space-3) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .chapter {
    display: grid; grid-template-columns: 3rem minmax(0, 17rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--rule);
  }
  .n {
    font-family: var(--display); font-size: var(--step-3); line-height: 1; color: var(--muted);
    text-align: right; padding-top: 2px;
  }
  .head { display: flex; flex-direction: column; gap: var(--space-1); }
  .head h3 { font-size: var(--step-1); }
  .sub { font-family: var(--display); font-style: italic; color: var(--muted); }
  .reading { display: flex; flex-direction: column; gap: var(--space-2); max-width: var(--measure); }
  .reading ul { list-style: none; margin: 0; padding: 0; }
  .reading a { display: inline-flex; align-items: center; min-height: 32px; padding-block: 2px; overflow-wrap: anywhere; }
  .reading .code a, .reading .try a { font-weight: 600; }
  .reading .gap { padding-top: var(--space-1); }

  @media (max-width: 860px) {
    .chapter { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .reading { grid-column: 2; }
  }
  @media (pointer: coarse), (max-width: 640px) {
    .reading a { min-height: var(--tap); padding-block: var(--space-2); }
  }

  .progress { font-weight: 600; }
  .entry .passed { color: var(--teal); font-weight: 600; }
</style>

<script>
  // Progress lives in this browser only, under the keys the old lab used, so earlier passes still count.
  const read = (k: string) => {
    try { return localStorage.getItem(k); } catch { return null; }
  };
  let passed = 0;
  document.querySelectorAll<HTMLElement>("[data-passed]").forEach((el) => {
    if (read(`passed:${el.dataset.passed}`) === "1") {
      el.hidden = false;
      passed++;
    }
  });
  const line = document.querySelector<HTMLElement>("[data-progress]");
  if (line && passed > 0) {
    line.textContent = `${passed} of ${line.dataset.total} passed in this browser`;
    line.hidden = false;
  }
</script>
