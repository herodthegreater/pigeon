---
// Mascot art check: every species in every condition, drawn at build time by the
// Coop's own code. Not linked from the site.
import Base from "../../layouts/Base.astro";
import "../../styles/page.css";
import { mascotSVG, SPECIES } from "../../lib/ui/mascot";

const conditions: [string, number, number][] = [["healthy", 0.95, 0.98], ["thin", 0.82, 0.9], ["starving", 0.66, 0.6], ["skeleton", 0.5, 0.3]];
const ratios = [1, ...SPECIES.slice(1).map((s) => s.minRatio)];
const birds = ratios.flatMap((ratio) =>
  conditions.map(([label, accuracy, pointing]) => {
    const m = mascotSVG({ ratio, accuracy, pointing });
    return { svg: m.svg, caption: `${m.dodo ? "Dodo" : m.species.name} · ${label}` };
  }),
);
---
<Base title="Aviary (dev) · Pigeon" description="Mascot art check: every species in every condition.">
  <main id="main" class="page">
    <header>
      <h1>Aviary</h1>
      <p class="lede">A development check for the mascot: every species in every condition, drawn by the same code as the Coop. Switch the theme in the header to check light and dark. This page isn't linked from the site.</p>
    </header>
    <ul class="grid">
      {birds.map((b) => (
        <li>
          <figure>
            <div set:html={b.svg} />
            <figcaption>{b.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </main>
  <style>
    .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-2); }
    figure { margin: 0; background: var(--card); border: 1px solid var(--rule); padding: var(--space-2); }
    figure :global(svg) { width: 100%; height: auto; display: block; }
    figcaption { text-align: center; color: var(--muted); font-size: var(--step--1); }
  </style>
</Base>
