---
import Base from "../../layouts/Base.astro";
import RunBox from "../../components/RunBox.astro";
import PigeonSays from "../../components/PigeonSays.astro";
import "../../styles/page.css";
import "../../styles/prose.css";
import { meta, methods, method, STATUS_LABEL } from "../../lib/lab/data";
import { md, highlight, inline, slug, type Heading } from "../../lib/lab/markdown";
import { BREAKS_HEADING, whenItBreaks } from "../../components/guide/breaks";
import Figures from "../../components/Figures.astro";

export function getStaticPaths() {
  return methods().map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const m = method(id!);
const M = meta();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const family = M.families[m.family];
const category = M.categories[m.category] ?? m.category;

const toc: Heading[] = [];
const body = m.page.trim() ? md(m.page, { toc }) : "";
const contents: Heading[] = [
  ...toc,
  ...(m.code.length ? [{ id: "source", text: "Source code" }] : []),
  ...(m.experiments.length ? [{ id: "simulations", text: "Simulation figures" }] : []),
  ...(m.papers.length ? [{ id: "papers", text: "Papers" }] : []),
];
const experiments = m.experiments;
const runnable = m.status === "runnable";
const codeNotes = toc.some((t) => t.id === "the-code-line-by-line");
const COCKPIT = "https://github.com/herodthegreater/pigeon/tree/main/cockpit";

// Pigeon's warning quotes the write-up's own "When it breaks": its first sentence or two.
const breaks = whenItBreaks(m.page);
const breaksId = slug(BREAKS_HEADING);
const breaksHref = breaks && toc.some((t) => t.id === breaksId) ? `#${breaksId}` : undefined;

// What the source code below is: this method's own code, or (for a reference page) the closest code that runs.
const sourceIntro = {
  runnable: "The exact code that runs, read from the repository when this page was built.",
  cockpit: "The exact code the cockpit runs, read from the repository when this page was built.",
  reference: "This method doesn't run here. Below is the closest code the lab does run, read from the repository when this page was built.",
}[m.status];
---
<Base title={`${m.name} · Field Guide · Pigeon`} active="guide" description={m.summary}>
  <main id="main" class="page method">
    <header>
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={`${base}guide/`}>Field Guide</a></li>
          <li><a href={`${base}guide/#${m.family}`}>{family.title}</a></li>
          <li><a href={`${base}guide/#${m.family}-${m.category}`}>{category}</a></li>
        </ol>
      </nav>
      <h1>{m.name}</h1>
      <p class="lede">{m.summary}</p>
      <p class="where">
        <span class:list={["status", m.status]}>{STATUS_LABEL[m.status]}</span>
        {runnable && <a class="jump-run" href="#run">Run it in your browser</a>}
      </p>
    </header>

    {contents.length > 0 && (
      <details class="toc-narrow">
        <summary>On this page <span class="count">({contents.length} sections)</span></summary>
        <nav aria-label="On this page">
          <ol>{contents.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      </details>
    )}

    <div class="cols">
      <article class="prose">
        {body ? <Fragment set:html={body} /> : <p class="gap">No write-up yet. The source code below is the reference.</p>}

        <h2 id="source">Source code</h2>
        {m.code.length ? (
          <>
            <p>{sourceIntro}</p>
            {m.code.map((c, k) => (
              <details class="src" open={k === 0}>
                <summary><code>{c.name}</code> <span class="where-in">{c.file}:{c.line}</span></summary>
                <pre tabindex="0"><code set:html={highlight(c.source)} /></pre>
              </details>
            ))}
          </>
        ) : (
          <p class="gap">
            The lab has no code for this method.{" "}
            {codeNotes ? <>See the write-up's section <a href="#the-code-line-by-line">The code, line by line</a>.</> : "The write-up is the whole entry."}
          </p>
        )}

        <h2 id="simulations">Simulation figures</h2>
        {experiments.length ? (
          experiments.map((e) => (
            <section class="sim" aria-labelledby={`sim-${e.name}`}>
              <h3 id={`sim-${e.name}`}>{e.title}</h3>
              <p class="question" set:html={inline(e.question)} />
              <Figures exp={e} numbersAt="results" lazy />
              {e.notes && <p class="note">{e.notes}</p>}
              <p><a class="solo" href={`${base}results/${e.name}/`}>Full table: {e.title}</a></p>
            </section>
          ))
        ) : (
          <p class="gap">No simulation in the lab covers this method yet.</p>
        )}

        <h2 id="papers">Papers</h2>
        {m.papers.length ? (
          <ul class="papers">{m.papers.map((p) => <li>{p}</li>)}</ul>
        ) : (
          <p class="gap">No papers are listed for this method.</p>
        )}
      </article>

      <div class="side">
        {runnable && <RunBox id={m.id} params={m.params} />}
        {m.status === "cockpit" && (
          <section class="panel" aria-labelledby="where-title">
            <h2 id="where-title">Runs in the cockpit</h2>
            <p>
              The source code on this page is the real code of the YOLOv8n cockpit, the tool in this repository that
              prunes, quantizes and fine-tunes a real detector. It runs on your own machine with PyTorch, not in the
              browser.
            </p>
            <p><a class="solo" href={COCKPIT}>The cockpit's code and quickstart on GitHub</a></p>
          </section>
        )}
        {m.status === "reference" && (
          <section class="panel" aria-labelledby="where-title">
            <h2 id="where-title">Reference only</h2>
            <p>
              This method needs a kind of model the lab doesn't have, so nothing on this page runs.{" "}
              {m.code.length
                ? "The write-up explains the algorithm, and the source code below it is the closest code that does run."
                : "The write-up explains the algorithm; the lab has no code for it."}
            </p>
          </section>
        )}
        {breaks && (
          <PigeonSays
            mood="warn"
            class="breaks"
            href={breaksHref}
            link={breaks.points > 1 ? `When it breaks: all ${breaks.points} points` : "When it breaks, in the write-up"}
          >
            <p set:html={inline(breaks.text)} />
          </PigeonSays>
        )}
        {contents.length > 0 && (
          <nav class="panel toc" aria-labelledby="toc-title">
            <h2 id="toc-title">On this page</h2>
            <ol>{contents.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        )}
        <section class="panel" aria-labelledby="build-title">
          <h2 id="build-title">Build it yourself</h2>
          {m.lessons.length ? (
            <>
              <p>Flight School lessons that have you write the pieces of this method in Python:</p>
              <ul class="lessons">
                {m.lessons.map((l) => <li><a href={`${base}school/${l.id}/`}>{l.title}</a></li>)}
              </ul>
            </>
          ) : (
            <p>No Flight School lesson builds this method yet.</p>
            <p><a class="solo" href={`${base}school/`}>All Flight School lessons</a></p>
          )}
        </section>
      </div>
    </div>
  </main>
</Base>

<style>
  .where { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .jump-run { display: inline-flex; align-items: center; min-height: 32px; font-size: var(--step--1); font-weight: 600; }

  .prose > :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .prose :global(h2), .prose h3, :global(#run) { scroll-margin-top: var(--space-4); }
  details.src + details.src { margin-top: var(--space-2); }
  details.src > summary {
    cursor: pointer; display: list-item; padding: var(--space-2) 0; font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  details.src > summary code { font-weight: 500; }
  .where-in { font-family: var(--mono); color: var(--muted); margin-left: var(--space-2); }
  details.src[open] > summary { margin-bottom: var(--space-2); }

  .sim { display: flex; flex-direction: column; gap: var(--space-3); }
  .sim + .sim { margin-top: var(--space-6); }
  .sim h3 { margin-top: 0; }
  .question { color: var(--muted); }
  .note { font-size: var(--step--1); color: var(--muted); }
  .papers li, .lessons li { overflow-wrap: anywhere; }

  .lessons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .lessons a { display: flex; align-items: center; min-height: 32px; font-size: var(--step--1); }

  /* Contents. On narrow screens the side panel falls below the whole write-up, so the
     contents come first instead, folded so they don't push the write-up down. Wide
     screens keep them in the side panel, beside the reading. */
  .toc-narrow { border-block: 1px solid var(--rule); max-width: var(--measure); }
  .toc-narrow > summary { cursor: pointer; padding-block: var(--space-2); font-size: var(--step--1); font-weight: 600; }
  .toc-narrow .count { font-weight: 400; color: var(--muted); }
  .toc-narrow ol { list-style: none; margin: 0; padding: 0 0 var(--space-2); }
  .toc-narrow a { display: flex; align-items: center; min-height: 32px; font-size: var(--step--1); }
  @media (min-width: 961px) { .toc-narrow { display: none; } }
  @media (max-width: 960px) { .side > .toc { display: none; } }

  /* Pigeon's warning sits between the run box and the contents, with a hairline above it
     so it reads as a note on the panel above, not as a panel of its own. */
  .side > :global(.breaks) { border-top: 1px solid var(--rule); padding-top: var(--space-3); }

  @media (pointer: coarse), (max-width: 640px) {
    .jump-run, .lessons a, .crumbs a, a.solo, .toc-narrow a { min-height: var(--tap); }
    .toc-narrow > summary { padding-block: var(--space-3); }
    .crumbs a, a.solo { display: inline-flex; align-items: center; }
    details.src > summary { padding-block: var(--space-3); }
  }
</style>

<style is:global>
  /* One bird per view: when a run result draws its own bird in the run box (mascotSVG's
     drawing, recognised by its viewBox), Pigeon's warning keeps its words and drops its drawing. */
  .method .side:has(.runbox svg[viewBox="22 38 230 160"]) > .breaks { grid-template-columns: minmax(0, 1fr); }
  .method .side:has(.runbox svg[viewBox="22 38 230 160"]) > .breaks > .pigeon-bird { display: none; }
</style>
