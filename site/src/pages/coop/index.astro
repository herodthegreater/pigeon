---
import Base from "../../layouts/Base.astro";
import CoopPicker from "../../components/CoopPicker.astro";
import { WORKS_LINE } from "../../lib/ui/mascot";
import { BROKEN_LINE, SPECIES_LADDER } from "../../lib/ui/coopbirds";
import "../../styles/coop.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const testsets = import.meta.glob<{ images: unknown[] }>("/public/testset/testset.json", { eager: true, import: "default" });
const photos = Object.values(testsets)[0]?.images?.length;
if (!photos) throw new Error("public/testset/testset.json is missing or has no images");
// The life list is its own page; the cage links to it only when that page is in the build, so no build ships a dead link.
const lifeList = Object.keys(import.meta.glob(["/src/pages/life-list.astro", "/src/pages/life-list/index.astro"], { query: "?raw", import: "default" })).length > 0;
---
<Base title="The Coop · Pigeon" active="coop" description="A sandbox for compressing a real bird-spotting model in your browser.">
  <main id="main" class="coop">
    <CoopPicker active="pigeon" />
    <section class="hero" aria-labelledby="bird-title">
      <div class="bird-card">
        <div class="bird" id="bird"></div>
        <div class="bird-meta">
          <p class="condition" id="bird-condition">Loading Pigeon…</p>
          <h1 id="bird-title"><span class="visually-hidden">The Coop: </span><span id="bird-name">Pigeon</span></h1>
          <p class="latin" id="bird-latin"></p>
          <p class="bird-note" id="bird-note">Fetching the model and {photos} test photos.</p>
          <noscript>
            <p class="bird-note">The Coop runs Pigeon inside your browser, so it needs JavaScript. Turn JavaScript on and reload the page.</p>
            <style is:inline>#bird-condition, #bird-note, #board, #work { display: none; }</style>
          </noscript>
          {lifeList && <p class="life"><a href={`${base}life-list/`}>Your life list</a> <span id="life-count"></span></p>}
          <button type="button" class="btn retry" id="retry" hidden>Reload the page</button>
        </div>
      </div>

      <div class="board" id="board" data-state="busy">
        <div class="status"><span id="status">Starting the engine…</span><span class="bar" aria-hidden="true"><span id="bar"></span></span></div>
        <dl class="metrics" id="metrics">
          <div class="metric"><dt>Accuracy</dt><dd class="value num"><span id="m-acc">…</span><small id="m-acc-d"></small></dd><dd class="desc">bird / no bird, right or wrong</dd></div>
          <div class="metric"><dt>Pointing</dt><dd class="value num"><span id="m-pt">…</span><small id="m-pt-d"></small></dd><dd class="desc">heatmap peak lands on the real bird</dd></div>
          <div class="metric"><dt>Agreement</dt><dd class="value num"><span id="m-ag">…</span></dd><dd class="desc">same answer as the original Pigeon</dd></div>
          <div class="metric"><dt>Size</dt><dd class="value num"><span id="m-size">…</span><small id="m-ratio"></small></dd><dd class="desc">real bytes, scales and indices included</dd></div>
        </dl>
        <p class="basis" id="basis"></p>
        <div class="record" id="record">
          <p id="best">No healthy compressed Pigeon yet.</p>
          <p class="rule-line">
            The bird's species follows how many times smaller Pigeon is than at full precision ({SPECIES_LADDER}).
            Its health follows Pigeon's own line: healthy at {WORKS_LINE}, a skeleton at {BROKEN_LINE}, starving in between.
          </p>
        </div>
      </div>
    </section>
    <p class="visually-hidden" id="announce" role="status" aria-live="polite" aria-atomic="true"></p>

    <div class="work" id="work">
      <section class="recipe-col" aria-labelledby="recipe-title">
        <h2 id="recipe-title">Recipe</h2>
        <p class="intro">Stack steps top to bottom, the way a real compression pipeline runs. Every change scores Pigeon again on its test photos.</p>
        <div id="recipe"><p class="waiting">The presets and steps appear once Pigeon has loaded.</p></div>
      </section>

      <div class="results">
        <section class="pane" aria-labelledby="tried-title">
          <div class="pane-head">
            <h2 id="tried-title">Everything you've tried</h2>
            <button type="button" class="btn secondary" id="clear" autocomplete="off" disabled>Clear history</button>
          </div>
          <div class="chart" id="pareto"><p class="waiting">Your runs are plotted here once the original Pigeon has been scored.</p></div>
          <details class="runs">
            <summary>Show every run as a table</summary>
            <div class="runs-scroll" id="pareto-table" tabindex="0" role="region" aria-label="Every run, as a table"><p class="waiting">No runs yet: the first one is the original Pigeon, scored as the page loads.</p></div>
          </details>
          <p class="caption">Each mark is one full {photos}-photo scoring run, kept in this browser, and marked by the bird's condition: a filled dot is healthy ({WORKS_LINE}), a hollow dot is starving, a cross is a skeleton ({BROKEN_LINE}). The magenta line joins the best tradeoffs: nothing else you tried is both smaller <em>and</em> more accurate.</p>
          <p class="caption" id="store-note" hidden>This browser won't let the page save anything, so these runs will be gone when you leave or reload.</p>
        </section>

        <section class="pane" aria-labelledby="drawer-title">
          <div class="pane-head">
            <h2 id="drawer-title">Specimen drawer</h2>
            <label class="check"><input type="checkbox" id="heat" autocomplete="off" checked disabled /> Show where Pigeon looks</label>
          </div>
          <div class="specimens heat" id="specimens"><p class="waiting">Test photos appear here with Pigeon's verdicts once the engine has scored them.</p></div>
          <p class="caption">Magenta shows what drives Pigeon's answer, and the ring marks its hottest point. Teal boxes are where the birds really are. A solid red border marks a wrong answer. A dashed border marks an answer this setting changed from the original Pigeon's: red if the change made it wrong, teal if it made it right.</p>
        </section>
      </div>
    </div>
  </main>

  <!-- Pigeon's own injected markup: the chart, the run table's disclosure, the heatmap and the step parts. The shared look is in styles/coop.css. -->
  <style is:global>
    /* Size vs accuracy chart: lib/ui/pareto.ts draws it at its on-screen width, so these sizes are real. */
    #pareto { background: var(--card); border: 1px solid var(--rule); padding: var(--space-2); }
    #pareto .waiting { padding: var(--space-3); }
    #pareto svg { width: 100%; height: auto; display: block; }
    #pareto .tick { font-family: var(--mono); font-size: var(--step--2); fill: var(--muted); }
    #pareto .axis { font-family: var(--body); font-size: var(--step--1); fill: var(--muted); }
    #pareto .works { font-family: var(--body); font-size: var(--step--1); font-weight: 600; fill: var(--teal); }
    .coop .runs summary { cursor: pointer; font-size: var(--step--1); color: var(--teal); width: fit-content; }
    .coop .runs .runs-scroll { margin-top: var(--space-2); }

    /* Applies to: one line per layer kind, with its share of the weights. */
    #recipe .parts { margin-top: var(--space-1); display: flex; flex-direction: column; gap: var(--space-1); }
    #recipe .part { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-2); align-items: center; font-size: var(--step--1); }
    #recipe .share { font-family: var(--mono); font-size: var(--step--2); color: var(--muted); }

    /* A wrong answer has a solid red border; an answer this setting changed has a dashed one, red if now wrong, teal if now right. */
    #specimens .specimen[data-correct="false"] .frame { border-color: var(--bad); }
    #specimens .specimen[data-flipped="true"] .frame { border-style: dashed; border-color: var(--teal); }
    #specimens .specimen[data-flipped="true"][data-correct="false"] .frame { border-color: var(--bad); }
    #specimens .specimen[data-correct="false"] .verdict { color: var(--bad); }
    #specimens canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.2s; mix-blend-mode: multiply; }
    #specimens.heat canvas { opacity: 1; }
    /* The peak: a light ring with a dark hairline outside it, so it reads on bright and dark photos alike. */
    #specimens .peak {
      position: absolute; width: 14px; height: 14px; translate: -50% -50%; border-radius: 50%;
      border: 2px solid var(--plate); outline: 1px solid var(--bird-line); opacity: 0;
    }
    #specimens.heat .peak { opacity: 1; }

    @media (pointer: coarse), (max-width: 640px) {
      .coop .runs summary { min-height: var(--tap); display: flex; align-items: center; }
      #recipe .part { min-height: var(--tap); }
    }
  </style>

  <script>
    import { Engine, QUICK, Unsupported, type Ready } from "../../lib/engine/client";
    import type { Result } from "../../lib/engine/worker";
    import { RecipeEditor, linkQuery, recipeFromLink, recipeKey } from "../../lib/ui/recipe";
    import { ratioShort } from "../../components/birds/format";
    import { mascotSVG, speciesNote, CONDITION_WORD, DODO } from "../../lib/ui/mascot";
    import { paretoSVG, paretoTable, smallestWorking, formatSize, type Attempt } from "../../lib/ui/pareto";
    import { Specimens, esc } from "../../lib/ui/specimens";
    import { bindLifeListCount, birdDrawer, cageHref, hatches, sight } from "../../lib/ui/coopbirds";

    const $ = (id: string) => document.getElementById(id)!;
    const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
    const CAGE = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}coop/`;

    // Every full run is kept in this browser. Runs saved before October 2026 under the old key used a size that
    // counted too few MX and NV block scales, so those are dropped rather than shown with a size that was too small.
    const STORE = "pigeon.coop.runs", OLD_STORE = "pigeon.coop.attempts";
    const runs = (raw: string | null): Attempt[] => {
      try {
        const v = JSON.parse(raw ?? "[]");
        return Array.isArray(v) ? v.filter((a) => a && typeof a.label === "string" && [a.bytes, a.accuracy, a.pointing].every(Number.isFinite)) : [];
      } catch {
        return []; // a damaged list starts over
      }
    };
    let attempts: Attempt[] = [];
    let canStore = true;
    try {
      const old = localStorage.getItem(OLD_STORE);
      if (old !== null) {
        // Old runs whose label no longer says what ran are dropped: MX/NV runs (sizes then undercounted their scales),
        // float runs from before labels named per-tensor scaling ("FP8 E4M3 · all" then meant either scaling), and
        // 2:4 runs (the old pipeline skipped a 2:4 step left at amount 0, so "2:4 · all" could mean nothing was pruned).
        const unknowable = (label: string) =>
          / (MX|NV)\/\d+/.test(label) || /\b(FP16|BF16|FP8 E4M3|FP8 E5M2|FP4 E2M1) ·/.test(label) || /(^|\s)2:4 ·/.test(label);
        if (localStorage.getItem(STORE) === null) localStorage.setItem(STORE, JSON.stringify(runs(old).filter((a) => !unknowable(a.label))));
        localStorage.removeItem(OLD_STORE);
      }
      attempts = runs(localStorage.getItem(STORE));
      localStorage.setItem(STORE, JSON.stringify(attempts)); // also proves this browser lets the page write
    } catch {
      canStore = false;
    }
    const save = () => { try { localStorage.setItem(STORE, JSON.stringify(attempts.slice(-200))); } catch {} };
    $("store-note").hidden = canStore;

    const lifeCount = document.getElementById("life-count");
    if (lifeCount) bindLifeListCount(lifeCount);

    const mb = (b: number) => `${(b / 1e6).toFixed(1)} MB`;
    const errText = (err: unknown) => (err instanceof Error ? err.message : String(err));
    const bar = $("bar") as HTMLElement;
    const status = (text: string, state: "busy" | "ok" | "error" = "busy") => {
      $("status").textContent = text;
      $("board").dataset.state = state;
    };

    // Screen readers hear one short line per finished 500-photo result or error, never the progress ticks.
    let announceTimer: ReturnType<typeof setTimeout> | undefined;
    function announce(text: string) {
      const el = $("announce");
      el.textContent = "";
      clearTimeout(announceTimer);
      announceTimer = setTimeout(() => { el.textContent = text; }, 100);
    }

    const engine = new Engine((b) => {
      if (b.stage === "download") status(`Downloading the model and test photos · ${mb(b.bytes)} so far`);
      else {
        bar.style.width = `${(b.done / b.total) * 100}%`;
        status(`Scoring the original Pigeon on ${b.total} photos… ${b.done}/${b.total}`);
      }
    });

    function failLoad(err: unknown) {
      // A browser without Web Workers or WebAssembly can't be fixed by a reload or a better connection, so it gets no Reload button.
      const unsupported = err instanceof Unsupported;
      const cond = $("bird-condition");
      cond.dataset.c = "error";
      cond.textContent = unsupported ? "Can't run in this browser" : "Couldn't load";
      $("bird-note").textContent = unsupported
        ? "This browser can't run the Coop: it needs Web Workers and WebAssembly. Open it in a current Chrome, Firefox, Safari or Edge."
        : `The engine stopped: ${errText(err)}. Check your connection and reload. If it keeps failing, try a current Chrome, Firefox, Safari or Edge.`;
      $("retry").hidden = unsupported;
      for (const id of ["metrics", "basis", "record", "work"]) $(id).hidden = true;
      bar.style.width = "0";
      status(unsupported ? "Can't start in this browser" : "Engine stopped", "error");
      announce(unsupported ? "The Coop can't run in this browser: it needs Web Workers and WebAssembly." : `The Coop couldn't load: ${errText(err)}`);
      return null;
    }
    $("retry").addEventListener("click", () => location.reload());

    const ready = await engine.ready.catch(failLoad);
    if (ready) {
      try { start(ready); } catch (err) { failLoad(err); }
    }

    function start({ images, baseline, tensors }: Ready) {
      const base = baseline;
      const sheet = (s: number) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}testset/sheet-${s}.webp`;
      const specimens = new Specimens($("specimens"), images, sheet, 10);
      let current: Attempt = { label: "Full precision", key: "", bytes: base.totalBytes, accuracy: base.score.accuracy, pointing: base.score.pointing };
      let lastFinal: Result = base; // what the board falls back to when a run fails
      const drawBird = birdDrawer($("bird"));
      const warned = { blocked: false };

      function delta(el: HTMLElement, v: number, ref: number) {
        const d = (v - ref) * 100;
        el.textContent = Math.abs(d) < 0.05 ? "±0.0" : `${d > 0 ? "+" : "−"}${Math.abs(d).toFixed(1)} pts`;
        el.className = Math.abs(d) < 0.05 ? "flat" : d > 0 ? "up" : "down";
      }

      // Quick results come from the first 100 photos: marked with ≈ until the full score lands.
      // Returns the drawn bird and the one-line summary that is announced for a full result.
      function show(r: Result, final: boolean) {
        const s = r.score;
        const est = final ? "" : "≈ ";
        const ratio = r.originalBytes / r.totalBytes;
        $("metrics").classList.toggle("estimate", !final);
        $("basis").textContent = final ? `Measured on all ${s.n} photos.` : `≈ Estimate from the first ${s.n} photos. Confirming on all ${images.length}…`;
        $("m-acc").textContent = est + pct(s.accuracy); delta($("m-acc-d"), s.accuracy, base.score.accuracy);
        $("m-pt").textContent = est + pct(s.pointing); delta($("m-pt-d"), s.pointing, base.score.pointing);
        $("m-ag").textContent = est + pct(s.agreement);
        $("m-size").textContent = formatSize(r.totalBytes);
        $("m-ratio").textContent = ratioShort(ratio);
        $("m-ratio").className = "flat";
        const m = mascotSVG({ ratio, accuracy: s.accuracy, pointing: s.pointing });
        drawBird(m.dodo ? "dodo" : m.species.id, m.svg);
        const cond = $("bird-condition");
        cond.dataset.c = m.condition;
        const word = CONDITION_WORD[m.condition];
        const condition = m.condition === "healthy" ? `${word} · still works` : m.condition === "emaciated" ? `${word} · ${Math.round(m.starve * 100)}% of the way to a skeleton` : `${word} · stopped working`;
        cond.textContent = final ? condition : `Early read · ${condition}`;
        const name = m.dodo ? DODO.name : m.species.name;
        $("bird-name").textContent = name;
        $("bird-latin").textContent = m.dodo ? DODO.latin : `${m.species.latin} · about ${m.species.grams} g`;
        $("bird-note").textContent = m.dodo ? DODO.note : m.condition === "skeleton" ? "This setting broke Pigeon: it's guessing." : speciesNote(m.species, ratio);
        if (final) specimens.update(r.logits, r.cams, base.logits);
        const summary = `Scored: accuracy ${pct(s.accuracy)}, pointing ${pct(s.pointing)}, ${formatSize(r.totalBytes)}, ${name}, ${word.toLowerCase()}`;
        return { m, name, ratio, summary };
      }

      // The chart is drawn at its on-screen width (see pareto.ts), and again when that width changes.
      const chart = $("pareto");
      const chartWidth = () => {
        const cs = getComputedStyle(chart);
        return chart.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      };
      let drawnWidth = 0;
      function drawChart() {
        drawnWidth = chartWidth();
        chart.innerHTML = paretoSVG(attempts, current, drawnWidth > 0 ? drawnWidth : undefined);
      }
      new ResizeObserver(() => { if (Math.abs(chartWidth() - drawnWidth) >= 1) drawChart(); }).observe(chart);

      function redrawChart() {
        drawChart();
        $("pareto-table").innerHTML = paretoTable(attempts, current);
        const best = smallestWorking(attempts, base.totalBytes);
        $("best").innerHTML = best
          ? `Smallest healthy Pigeon so far: <strong>${formatSize(best.bytes)}</strong> (${ratioShort(base.totalBytes / best.bytes)}, ${pct(best.accuracy)} accurate): <em>${esc(best.label)}</em>`
          : "No healthy compressed Pigeon yet.";
      }

      const editor = new RecipeEditor($("recipe"), tensors, (recipe, label) => {
        let estimated = false;
        bar.style.width = "0";
        status(`Scoring on ${QUICK} photos…`);
        engine.evaluate(recipe, {
          onProgress: (done, total, stage) => {
            bar.style.width = `${(done / total) * 100}%`;
            status(stage === "quick" ? `Scoring on ${QUICK} photos… ${done}/${total}` : `Quick estimate shown · confirming on all ${total}… ${done}/${total}`);
          },
          onQuick: (r) => { estimated = true; show(r, false); },
          onFull: (r) => {
            const shown = show(r, true);
            lastFinal = r;
            const key = recipeKey(recipe);
            current = { label, key, bytes: r.totalBytes, accuracy: r.score.accuracy, pointing: r.score.pointing };
            const dup = attempts.findIndex((a) => (a.key ? a.key === key : a.label === label));
            if (dup >= 0) attempts.splice(dup, 1);
            attempts.push(current);
            save();
            redrawChart();
            // Only a Pigeon that came out smaller goes on the life list: never the full-precision reference, nor a recipe
            // that leaves it as big as it was. Its bird is graded by Pigeon's own line, so the sighting carries the pointing too.
            const { m } = shown;
            const life = !hatches(shown.ratio) ? { said: "", announce: false } : sight({
              bird: { ratio: shown.ratio, kept: r.score.accuracy / base.score.accuracy, condition: m.condition, starve: m.starve, species: m.dodo ? "dodo" : m.species.id, name: shown.name },
              model: "pigeon", modelName: "Pigeon", recipe: label, recipeKey: key, href: cageHref(CAGE, linkQuery(recipe)), rule: "pigeon", pointing: r.score.pointing, accuracy: r.score.accuracy,
            }, warned);
            status(`Scored on all ${r.score.n} photos · ${Math.round(r.ms.infer)} ms${life.said ? ` · ${life.said}` : ""}`, "ok");
            announce(life.announce ? `${shown.summary}. ${life.said}` : shown.summary);
          },
          onError: (message) => {
            // Put the board back on the last run that finished, so every number on it is one that was measured in full.
            bar.style.width = "0";
            show(lastFinal, true);
            status(estimated
              ? `Scoring failed on all ${images.length} photos (${message}), so the quick estimate was dropped. The numbers below are from your last finished run. Change the recipe, or pick it again, to retry.`
              : `Scoring failed (${message}). The numbers below are from your last finished run. Change the recipe, or pick it again, to retry.`, "error");
            announce(`Scoring failed: ${message}. The board shows your last finished run again.`);
          },
        });
      });

      const summary = show(base, true).summary;
      if (!attempts.some((a) => (a.key !== undefined ? a.key === current.key : a.label === current.label))) attempts.push(current);
      redrawChart();
      status(`Scored on all ${base.score.n} photos · ready`, "ok");

      // Firefox can restore a checkbox's state on reload, so the drawer follows the box rather than the markup.
      const heat = $("heat") as HTMLInputElement, clear = $("clear") as HTMLButtonElement;
      $("specimens").classList.toggle("heat", heat.checked);
      heat.addEventListener("change", () => $("specimens").classList.toggle("heat", heat.checked));
      clear.addEventListener("click", () => { attempts = [current]; save(); redrawChart(); });
      heat.disabled = clear.disabled = false;

      // A link can carry a recipe: ?preset=<id> (Flight School and the Field Guide) or ?steps=… (a life-list sighting).
      // It loads as if it had been built by hand, and focus stays where the visitor is.
      const link = recipeFromLink(new URLSearchParams(location.search));
      if (link && "recipe" in link) editor.load(link.recipe, link.preset, false);
      else if (link) {
        status(`This link's recipe couldn't be read (${link.error}), so the board shows the full-precision Pigeon. Pick a preset or add steps below.`, "error");
        announce("This link's recipe couldn't be read, so the Coop shows the full-precision Pigeon.");
      } else announce(`Ready. ${summary}`);
    }
  </script>
</Base>
