---
import Base from "../../layouts/Base.astro";
import CoopPicker from "../../components/CoopPicker.astro";
import { SPECIES } from "../../lib/ui/mascot";
import { HEALTHY_KEEP, SKELETON_KEEP } from "../../lib/detector/score";
import { QUICK } from "../../lib/detector/recipe";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const testsets = import.meta.glob<{ images: unknown[] }>("/public/testset/testset.json", { eager: true, import: "default" });
const photos = Object.values(testsets)[0]?.images?.length;
if (!photos) throw new Error("public/testset/testset.json is missing or has no images");
const models = import.meta.glob<{ imgsz: number; params: number; recorded: { ap: Record<string, { all: number }>; ultralytics: string; date: string } }>(
  "/public/coop/yolov8n/model.json", { eager: true, import: "default" },
);
const model = Object.values(models)[0];
if (!model) throw new Error("public/coop/yolov8n/model.json is missing: run cockpit/build_coop.py");
const rec = model.recorded;
const ladder = SPECIES.filter((s) => s.minRatio > 0).map((s) => `${s.name.split(" ").pop()!.toLowerCase()} from ${s.minRatio}×`).join(", ");
const keepPct = (v: number) => `${Math.round(v * 100)}%`;
---
<Base title="YOLOv8n · The Coop · Pigeon" active="coop" description="Compress YOLOv8n, a real bird-finding detector, in your browser and score it on 500 test photos.">
  <main id="main" class="coop">
    <CoopPicker active="yolo" />
    <section class="hero" aria-labelledby="bird-title">
      <div class="bird-card">
        <div class="bird" id="bird"></div>
        <div class="bird-meta">
          <p class="condition" id="bird-condition">Loading YOLOv8n…</p>
          <h1 id="bird-title"><span class="visually-hidden">The Coop, YOLOv8n: </span><span id="bird-name">YOLOv8n</span></h1>
          <p class="latin" id="bird-latin"></p>
          <p class="bird-note" id="bird-note">Fetching the detector and {photos} test photos.</p>
          <noscript>
            <p class="bird-note">The Coop runs YOLOv8n inside your browser, so it needs JavaScript. Turn JavaScript on and reload the page.</p>
            <style is:inline>#bird-condition, #bird-note, #board, #work { display: none; }</style>
          </noscript>
          <button type="button" class="btn retry" id="retry" hidden>Reload the page</button>
        </div>
      </div>

      <div class="board" id="board" data-state="busy">
        <div class="status"><span id="status">Starting the engine…</span><span class="bar" aria-hidden="true"><span id="bar"></span></span></div>
        <dl class="metrics" id="metrics">
          <div class="metric"><dt>Bird AP@50</dt><dd class="value num"><span id="m-ap">…</span><small id="m-ap-d"></small></dd><dd class="desc">1.0 finds every bird, boxed, with no false alarms</dd></div>
          <div class="metric"><dt>AP kept</dt><dd class="value num"><span id="m-kept">…</span></dd><dd class="desc">of the native model's AP: the bird's health</dd></div>
          <div class="metric"><dt>Size</dt><dd class="value num"><span id="m-size">…</span><small id="m-ratio"></small></dd><dd class="desc" id="m-size-desc">real bytes, scales included</dd></div>
          <div class="metric"><dt>Compute</dt><dd class="value num"><span id="m-macs">…</span><small id="m-macs-d"></small></dd><dd class="desc">multiply-adds per photo, live channels only</dd></div>
        </dl>
        <p class="basis" id="basis"></p>
        <p class="rule-line" id="rule">
          The bird's species follows how many times smaller the weights are than native ({ladder}).
          Its health follows AP kept: healthy at {keepPct(HEALTHY_KEEP)} of native or more, a skeleton at {keepPct(SKELETON_KEEP)} or less, starving in between.
        </p>
      </div>
    </section>
    <p class="visually-hidden" id="announce" role="status" aria-live="polite" aria-atomic="true"></p>

    <div class="work" id="work">
      <section class="recipe-col" aria-labelledby="recipe-title">
        <div class="pane-head">
          <h2 id="recipe-title">Recipe</h2>
          <button type="button" class="btn secondary" id="reset" disabled>Reset to native</button>
        </div>
        <p class="intro">One precision for every weight, and a channel cut for each stage. Every change scores YOLOv8n again: first on {QUICK} photos for a quick estimate, then on all {photos}.</p>
        <div id="recipe"><p class="waiting">The controls appear once native YOLOv8n has been scored.</p></div>
      </section>

      <div class="results">
        <section class="pane" aria-labelledby="eyes-title">
          <h2 id="eyes-title">Through YOLOv8n's eyes</h2>
          <div class="specimens" id="tiles"><p class="waiting">Bird photos appear here with YOLOv8n's boxes once the engine has scored them.</p></div>
          <p class="caption">Twelve bird photos from the test set. Teal boxes are where the birds really are. Magenta dashed boxes are what YOLOv8n reports with more than 25% confidence. A red border means this recipe finds fewer birds in the photo than native YOLOv8n did.</p>
        </section>

        <section class="pane" aria-labelledby="tried-title">
          <div class="pane-head">
            <h2 id="tried-title">Everything you've tried</h2>
            <button type="button" class="btn secondary" id="clear" disabled>Clear history</button>
          </div>
          <div class="runs-scroll" id="runs"><p class="waiting">No runs yet: the first one is native YOLOv8n, scored as the page loads.</p></div>
          <p class="caption">One row per full {photos}-photo scoring run, kept in this browser. The highlighted row is the recipe on screen now.</p>
        </section>

        <section class="pane about" aria-labelledby="about-title">
          <h2 id="about-title">How this cage keeps score</h2>
          <p>YOLOv8n runs here, in a background worker on your graphics chip (TensorFlow.js on WebGL), on the same {photos} Open Images photos as Pigeon, at {model.imgsz} × {model.imgsz} pixels. A detection counts when its box overlaps a real bird by at least half; the photos without birds count too, as places to raise false alarms. Native AP is measured once as the page loads and every recipe is compared with it. It won't match the COCO scores Ultralytics publishes, which use 640-pixel photos and all 80 classes.</p>
          <p>When the weights were exported, the cockpit's PyTorch evaluator scored native YOLOv8n at {rec.ap.native.all.toFixed(3)} on these photos, INT8 per channel at {rec.ap.int8_channel.all.toFixed(3)} and INT4 per channel at {rec.ap.int4_channel.all.toFixed(3)} (recorded {rec.date} with Ultralytics {rec.ultralytics}, not measured on this page). Your browser's numbers should land within a few thousandths of these.</p>
          <p>Size counts every stored bit: weights at the recipe's precision, one 16-bit number per shared scale, and biases kept at 16 bits. Native is Ultralytics' checkpoint with BatchNorm folded into the convolutions, stored as fp16: {(model.params * 2 / 1e6).toFixed(2)} MB for {(model.params / 1e6).toFixed(2)} million parameters. Precision never changes compute; only channel cuts do.</p>
          <p class="credits">
            YOLOv8n is by <a href="https://github.com/ultralytics/ultralytics">Ultralytics</a>, under the <a href="https://github.com/ultralytics/ultralytics/blob/main/LICENSE">AGPL-3.0 license</a>.
            The photos come from Open Images; each one is credited by name in the <a href={`${base}coop/#drawer-title`}>specimen drawer on Pigeon's page</a>, and the twelve above link to their sources.
          </p>
        </section>
      </div>
    </div>
  </main>

  <!-- The page's own markup: the same look as the Pigeon cage (coop/index.astro). -->
  <style>
    .coop {
      max-width: 1320px; margin: 0 auto; padding: var(--space-5) var(--gutter) var(--space-8);
      display: flex; flex-direction: column; gap: var(--space-6);
    }
    h2 { font-size: var(--step-2); }

    .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-5); }
    .bird-card {
      background: var(--card); border: 1px solid var(--rule); display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-5) var(--space-3) var(--space-2);
    }
    .bird { transition: opacity 0.25s; }
    .bird.swap { opacity: 0; }
    .bird-meta { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
    .bird-meta h1 { font-size: var(--step-3); }
    .latin { font-family: var(--display); font-style: italic; color: var(--magenta); }
    .bird-note { color: var(--muted); margin-top: var(--space-2); }
    .retry { align-self: start; margin-top: var(--space-2); }
    /* The bird's condition: a plain sentence-case line whose color is the state. */
    .condition { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
    .condition[data-c="healthy"] { color: var(--good); }
    .condition[data-c="emaciated"] { color: var(--warn); }
    .condition[data-c="skeleton"], .condition[data-c="error"] { color: var(--bad); }

    .board { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
    .status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); font-family: var(--mono); font-size: var(--step--1); color: var(--muted); }
    .bar { flex: 1 1 120px; height: 3px; background: var(--sunk); max-width: 220px; }
    .bar span { display: block; height: 100%; width: 0; background: var(--teal); transition: width 0.15s; }
    .board[data-state="error"] .status { color: var(--bad); font-family: var(--body); }
    .board[data-state="error"] .bar { display: none; }

    .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; border: 1px solid var(--rule); background: var(--card); }
    .metric { padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
    .metric + .metric { border-left: 1px solid var(--rule); }
    .metric dt { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
    .metric dd { margin: 0; }
    .value {
      font-family: var(--display); font-size: var(--step-3); font-weight: 600; line-height: 1.1;
      display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-2);
    }
    .value small { font-family: var(--mono); font-size: var(--step--2); font-weight: 400; }
    .value small.down { color: var(--bad); }
    .value small.up { color: var(--good); }
    .value small.flat { color: var(--muted); }
    .metrics.estimate .value > span:first-child { color: var(--muted); }
    .desc { font-size: var(--step--2); color: var(--muted); line-height: 1.35; }
    .basis { font-size: var(--step--1); color: var(--muted); }
    .basis:empty { display: none; }
    /* The rule the bird follows: a ruled record line, like an entry in a field notebook. */
    .rule-line { border-block: 1px solid var(--rule); padding-block: var(--space-3); font-size: var(--step--1); }

    .work { display: grid; grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
    /* Sticky and scrollable on wide screens; the padding keeps focus rings inside the scroll box. */
    .recipe-col {
      display: flex; flex-direction: column; gap: var(--space-3); position: sticky; top: var(--space-3);
      max-height: calc(100vh - 2 * var(--space-3)); overflow: auto; padding: var(--space-1); margin: calc(-1 * var(--space-1));
    }
    .intro { color: var(--muted); font-size: var(--step--1); }

    .results { display: flex; flex-direction: column; gap: var(--space-6); min-width: 0; }
    .pane { display: flex; flex-direction: column; gap: var(--space-3); }
    .pane-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
    .caption { font-size: var(--step--1); color: var(--muted); max-width: var(--measure); }
    .waiting { font-family: var(--mono); font-size: var(--step--1); color: var(--muted); padding: var(--space-3) 0; }
    .specimens .waiting { grid-column: 1 / -1; }
    .runs-scroll { overflow-x: auto; }
    .about { border-top: 1px solid var(--rule); padding-top: var(--space-4); }
    .about p { max-width: var(--measure); font-size: var(--step--1); }
    .about .credits { color: var(--muted); }

    /* Touch: the credit links get a full tap target, even mid-sentence. */
    @media (pointer: coarse), (max-width: 640px) {
      .about a { display: inline-flex; align-items: center; min-height: var(--tap); }
    }
    @media (max-width: 1000px) {
      .hero, .work { grid-template-columns: minmax(0, 1fr); }
      .recipe-col { position: static; max-height: none; overflow: visible; }
    }
    @media (max-width: 640px) {
      .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .metric:nth-child(3) { border-left: 0; }
      .metric:nth-child(n + 3) { border-top: 1px solid var(--rule); }
      .bird-card { grid-template-columns: minmax(0, 1fr); padding: var(--space-3); }
    }
  </style>

  <!-- Markup the scripts inject (bird, recipe editor, photo tiles, runs table). -->
  <style is:global>
    #bird svg { width: 100%; height: auto; display: block; }
    .coop input[type="radio"], .coop input[type="range"] { accent-color: var(--teal); }

    /* Recipe editor: lib/ui/yolorecipe.ts */
    #recipe { display: flex; flex-direction: column; gap: var(--space-4); }
    #recipe .sub { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
    #recipe .presets { display: flex; flex-direction: column; gap: var(--space-2); }
    #recipe .preset-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    #recipe button {
      display: inline-flex; align-items: center; min-height: 36px; padding: var(--space-1) var(--space-3);
      border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--card); color: var(--ink);
      font-size: var(--step--1); cursor: pointer;
    }
    #recipe button:hover { border-color: var(--teal); }
    #recipe button:disabled { opacity: 0.6; cursor: default; }
    #recipe button:disabled:hover { border-color: var(--rule-strong); }
    #recipe .preset[aria-pressed="true"] { background: var(--teal-wash); border-color: var(--teal); font-weight: 600; }
    #recipe .remove { color: var(--muted); }
    /* Two lines reserved, so the steps below don't jump as hints change. */
    #recipe .preset-hint { font-size: var(--step--1); color: var(--muted); min-height: 3.1em; }
    #recipe .step { border: 1px solid var(--rule); background: var(--card); }
    #recipe .step-head { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--rule); }
    #recipe .step-head h3 { font-size: var(--step-1); flex: 1; }
    #recipe .step-body { padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
    #recipe .field { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); font-size: var(--step--1); }
    #recipe .field output { font-family: var(--mono); color: var(--teal); }
    #recipe .field select {
      min-height: 36px; padding: var(--space-1) var(--space-2);
      border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--paper); color: var(--ink);
    }
    #recipe input[type="range"] { width: 100%; margin: 0; }
    #recipe fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
    #recipe fieldset:disabled { opacity: 0.6; }
    #recipe legend { padding: 0; margin-bottom: var(--space-1); }
    #recipe .note { font-size: var(--step--1); color: var(--muted); }
    #recipe .seg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--rule-strong); border-radius: var(--radius); overflow: hidden; }
    #recipe .seg.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #recipe .seg label { position: relative; }
    #recipe .seg input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
    #recipe .seg span { display: grid; place-items: center; min-height: 32px; padding: var(--space-1); text-align: center; font-size: var(--step--1); }
    #recipe .seg label + label span { border-left: 1px solid var(--rule-strong); }
    #recipe .seg input:checked + span { background: var(--teal-wash); color: var(--ink); font-weight: 600; }
    #recipe .seg input:focus-visible + span { outline: 2px solid var(--magenta); outline-offset: -2px; }
    #recipe fieldset:disabled .seg input { cursor: default; }
    /* Stage cuts: one ruled line per stage, the label (layer, kind, share of compute), its slider, its value. */
    #recipe .stages { display: flex; flex-direction: column; margin-top: var(--space-2); }
    #recipe .stage {
      display: grid; grid-template-columns: 9.5em minmax(0, 1fr) 3em; align-items: center; gap: 0 var(--space-3);
      padding-block: var(--space-1); border-top: 1px solid var(--rule); font-size: var(--step--1);
    }
    #recipe .stage label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-2); line-height: 1.3; }
    #recipe .stage .st { font-weight: 600; }
    #recipe .stage .kind { color: var(--muted); }
    #recipe .stage .share { flex-basis: 100%; font-family: var(--mono); font-size: var(--step--2); color: var(--muted); }
    #recipe .stage output { font-family: var(--mono); color: var(--teal); text-align: right; }

    /* Photo tiles: lib/ui/detections.ts */
    #tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-3); }
    #tiles .specimen { margin: 0; display: flex; flex-direction: column; gap: var(--space-1); position: relative; }
    #tiles .frame { position: relative; aspect-ratio: 1; max-width: 100%; background-repeat: no-repeat; border: 2px solid transparent; }
    #tiles .specimen[data-lost="true"] .frame { border-color: var(--bad); }
    #tiles .boxes { position: absolute; inset: 0; width: 100%; height: 100%; }
    #tiles .truth-boxes rect { fill: none; stroke: var(--truth-box); stroke-width: 1; vector-effect: non-scaling-stroke; }
    #tiles .found-boxes rect { fill: none; stroke: var(--detect-box); stroke-width: 2; stroke-dasharray: 5 3; vector-effect: non-scaling-stroke; }
    #tiles figcaption { display: flex; flex-direction: column; font-size: var(--step--2); line-height: 1.3; }
    #tiles .truth { font-weight: 600; }
    #tiles .verdict { color: var(--muted); }
    #tiles .specimen[data-lost="true"] .verdict { color: var(--bad); }
    #tiles .was { color: var(--muted); }
    #tiles .was:empty { display: none; }
    #tiles .credit { font-size: var(--step--2); color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* The whole tile is the link to the source photo, so the tap target is the photo, not a 12px line of text. */
    #tiles .credit::after { content: ""; position: absolute; inset: 0; }
    /* The hidden "(opens in a new tab)" would otherwise sit past the clipped credit line, off the page's right edge. */
    #tiles .credit .visually-hidden { left: 0; top: 0; }
    #tiles .specimen:hover .credit { text-decoration: underline; }
    @supports selector(:has(*)) {
      #tiles .specimen:has(.credit:focus-visible) { outline: 2px solid var(--magenta); outline-offset: 2px; }
      #tiles .credit:focus-visible { outline: none; }
    }

    /* Runs table */
    #runs table { border-collapse: collapse; width: 100%; font-size: var(--step--1); }
    #runs th, #runs td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--rule); }
    #runs th { font-weight: 600; }
    #runs td:first-child { min-width: 10em; }
    #runs .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    #runs tr[aria-current="true"] td { background: var(--teal-wash); }
    #runs td.c-healthy { color: var(--good); }
    #runs td.c-emaciated { color: var(--warn); }
    #runs td.c-skeleton { color: var(--bad); }

    /* Touch: every injected control gets a 44px target. */
    @media (pointer: coarse), (max-width: 640px) {
      #recipe button, #recipe .field select, #recipe .seg span { min-height: var(--tap); }
      #recipe .remove { padding-inline: var(--space-3); }
      #recipe input[type="range"] { height: var(--tap); }
    }
    @media (max-width: 640px) {
      #tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #recipe .stage { grid-template-columns: 8.5em minmax(0, 1fr) 2.75em; gap: 0 var(--space-2); }
    }
  </style>

  <script>
    import { DetectorEngine, missingSupport, NoWebGL, type Boot, type Ready, type Result } from "../../lib/detector/client";
    import { YoloRecipeEditor } from "../../lib/ui/yolorecipe";
    import { Detections } from "../../lib/ui/detections";
    import { detectorCondition } from "../../lib/detector/score";
    import { describe, nativeRecipe, QUICK } from "../../lib/detector/recipe";
    import { sheetUrl } from "../../lib/detector/files";
    import { mascotSVG, DODO } from "../../lib/ui/mascot";

    const $ = (id: string) => document.getElementById(id)!;
    const STORE = "pigeon.coop.yolo.runs";
    const errText = (err: unknown) => (err instanceof Error ? err.message : String(err));
    const mb = (b: number) => `${(b / 1e6).toFixed(1)} MB`;
    const size = (b: number) => (b >= 1e6 ? `${(b / 1e6).toFixed(2)} MB` : `${Math.round(b / 1e3)} KB`);
    const gmacs = (m: number) => `${(m / 1e9).toFixed(3)} G`;
    const secs = (ms: number) => (ms < 1000 ? `${Math.round(ms)} ms` : `${(ms / 1000).toFixed(1)} s`);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

    interface Run { label: string; ap: number; kept: number; bytes: number; macs: number; condition: string }
    let runs: Run[] = [];
    try { runs = JSON.parse(localStorage.getItem(STORE) ?? "[]"); } catch {}
    const save = () => { try { localStorage.setItem(STORE, JSON.stringify(runs.slice(-100))); } catch {} };

    const bar = $("bar");
    const status = (text: string, state: "busy" | "ok" | "error" = "busy") => {
      $("status").textContent = text;
      $("board").dataset.state = state;
    };

    // Screen readers hear one short line per finished 500-photo result or error, never the progress ticks.
    let announceTimer: ReturnType<typeof setTimeout> | undefined;
    function announce(text: string) {
      const el = $("announce");
      el.textContent = "";
      clearTimeout(announceTimer);
      announceTimer = setTimeout(() => { el.textContent = text; }, 100);
    }

    function onBoot(b: Boot) {
      if (b.stage === "download") {
        bar.style.width = b.total ? `${Math.min(1, b.got / b.total) * 100}%` : "0";
        status(`Downloading YOLOv8n's weights and the test photos · ${mb(b.got)}${b.total ? ` of ${mb(b.total)}` : " so far"}`);
      } else if (b.stage === "photos") {
        bar.style.width = `${(b.done / b.total) * 100}%`;
        status(`Cutting the test photos from their sheets · ${b.done}/${b.total}`);
      } else if (b.stage === "gpu") {
        bar.style.width = "0";
        status("Starting WebGL and compiling YOLOv8n for your graphics chip (slowest on a first visit)…");
      } else {
        bar.style.width = `${(b.done / b.total) * 100}%`;
        status(`Scoring native YOLOv8n on ${b.total} photos… ${b.done}/${b.total}`);
      }
    }

    function failLoad(err: unknown, cantRun = false) {
      const cond = $("bird-condition");
      cond.dataset.c = "error";
      cond.textContent = cantRun ? "Can't run in this browser" : "Couldn't load";
      $("bird-note").textContent = cantRun
        ? `YOLOv8n needs WebGL 2 in a background worker to run on your graphics chip, but ${errText(err)}. Turn on hardware acceleration in your browser's settings, or open this page in a recent Chrome, Edge, Firefox or Safari (17 or newer), then reload.`
        : `The detector stopped: ${errText(err)}. Check your connection and reload. If it keeps failing, try a recent Chrome, Edge, Firefox or Safari.`;
      $("retry").hidden = false;
      for (const id of ["metrics", "basis", "rule", "work"]) $(id).hidden = true;
      bar.style.width = "0";
      status(cantRun ? "Can't start in this browser" : "Engine stopped", "error");
      announce(`The detector couldn't start: ${errText(err)}`);
      return null;
    }
    $("retry").addEventListener("click", () => location.reload());

    const unsupported = missingSupport();
    if (unsupported) failLoad(new Error(unsupported), true);
    else {
      const engine = new DetectorEngine(onBoot);
      const ready = await engine.ready.catch((err) => failLoad(err, err instanceof NoWebGL));
      if (ready) {
        try { start(engine, ready); } catch (err) { failLoad(err); }
      }
    }

    function start(engine: DetectorEngine, ready: Ready) {
      const native = ready.native;
      const tiles = new Detections($("tiles"), ready.previews, sheetUrl, ready.grid, 224);
      tiles.update(native.previews, native.previews);
      let shownSpecies = "";
      let current: Run | null = null;

      function delta(el: HTMLElement, v: number, ref: number) {
        const d = v - ref;
        el.textContent = Math.abs(d) < 0.0005 ? "±0.000" : `${d > 0 ? "+" : "−"}${Math.abs(d).toFixed(3)}`;
        el.className = Math.abs(d) < 0.0005 ? "flat" : d > 0 ? "up" : "down";
      }

      type Shown = Pick<Result, "ap" | "nativeAp" | "cost" | "n" | "final">;
      // Quick results come from the first 100 photos: marked with ≈ until the full score lands.
      // Returns the one-line summary that is announced for a full result.
      function show(r: Shown): string {
        const est = r.final ? "" : "≈ ";
        const { condition, starve, kept } = detectorCondition(r.ap, r.nativeAp);
        const ratio = native.cost.bytes / r.cost.bytes;
        $("metrics").classList.toggle("estimate", !r.final);
        $("basis").textContent = r.final
          ? `Measured on all ${r.n} photos in this browser.${ready.float32 ? "" : " This graphics chip computes in 16-bit floats, so scores can differ slightly from other devices."}`
          : `≈ Estimate from the first ${r.n} photos, against native AP on the same ${r.n}. Confirming on all ${ready.n}…`;
        $("m-ap").textContent = est + r.ap.toFixed(3);
        delta($("m-ap-d"), r.ap, r.nativeAp);
        $("m-kept").textContent = `${est}${(kept * 100).toFixed(1)}%`;
        $("m-size").textContent = size(r.cost.bytes);
        $("m-ratio").textContent = `${ratio.toFixed(2)}× smaller`;
        $("m-ratio").className = "flat";
        const cut = r.cost.macs < native.cost.macs ? ", cut channels left out" : "";
        $("m-size-desc").textContent = r.cost.effBits < 16 ? `${r.cost.effBits.toFixed(2)} bits per weight, scales included${cut}` : cut ? `16 bits per weight${cut}` : "16 bits per weight, as shipped";
        $("m-macs").textContent = gmacs(r.cost.macs);
        $("m-macs-d").textContent = `${((r.cost.macs / native.cost.macs) * 100).toFixed(1)}% of native`;
        $("m-macs-d").className = "flat";

        const m = mascotSVG({ ratio, starve });
        const bird = $("bird"), key = m.dodo ? "dodo" : m.species.id;
        if (key !== shownSpecies && shownSpecies) {
          bird.classList.add("swap");
          setTimeout(() => { bird.innerHTML = m.svg; bird.classList.remove("swap"); }, 180);
        } else bird.innerHTML = m.svg;
        shownSpecies = key;
        const cond = $("bird-condition");
        cond.dataset.c = condition;
        const words = condition === "healthy" ? "Healthy · still finds the birds" : condition === "emaciated" ? `Starving · ${Math.round(starve * 100)}% of the way to bones` : "Skeleton · broken";
        cond.textContent = r.final ? words : `Early read · ${words}`;
        const name = m.dodo ? DODO.name : m.species.name;
        $("bird-name").textContent = name;
        $("bird-latin").textContent = m.dodo ? DODO.latin : `${m.species.latin} · about ${m.species.grams} g`;
        $("bird-note").textContent = m.dodo
          ? "You broke YOLOv8n without making it much smaller. Impressive."
          : condition === "skeleton"
            ? "This recipe broke YOLOv8n: it has lost most of the birds."
            : m.species.id === "pigeon"
              ? "Native weight, or close to it: less than 1.8 times smaller."
              : m.species.note;
        const plain = condition === "healthy" ? "healthy" : condition === "emaciated" ? "starving" : "skeleton";
        return `Scored: bird AP ${r.ap.toFixed(3)}, ${Math.round(kept * 100)}% of native, ${size(r.cost.bytes)}, ${name}, ${plain}`;
      }

      function drawRuns() {
        if (!runs.length) {
          $("runs").innerHTML = `<p class="waiting">No runs kept. Change the recipe to add one.</p>`;
          return;
        }
        const rows = [...runs].reverse().map((a) => `<tr${current && a.label === current.label ? ' aria-current="true"' : ""}>
          <td>${esc(a.label)}</td><td class="num">${a.ap.toFixed(3)}</td><td class="num c-${a.condition}">${(a.kept * 100).toFixed(1)}%</td>
          <td class="num">${size(a.bytes)}</td><td class="num">${gmacs(a.macs)}</td></tr>`).join("");
        $("runs").innerHTML = `<table><thead><tr><th scope="col">Recipe</th><th scope="col" class="num">Bird AP@50</th><th scope="col" class="num">AP kept</th><th scope="col" class="num">Size</th><th scope="col" class="num">Compute</th></tr></thead><tbody>${rows}</tbody></table>`;
      }

      function record(r: Shown, label: string) {
        const { condition, kept } = detectorCondition(r.ap, r.nativeAp);
        current = { label, ap: r.ap, kept, bytes: r.cost.bytes, macs: r.cost.macs, condition };
        runs = runs.filter((a) => a.label !== label);
        runs.push(current);
        save();
        drawRuns();
      }

      const reset = $("reset") as HTMLButtonElement, clear = $("clear") as HTMLButtonElement;
      const editor = new YoloRecipeEditor($("recipe"), ready.stages, (recipe, label) => {
        reset.disabled = label === describe(nativeRecipe());
        bar.style.width = "0";
        status(`Applying the recipe, then scoring on ${QUICK} photos…`);
        engine.evaluate(recipe, {
          onProgress: (done, total, final) => {
            bar.style.width = `${(done / total) * 100}%`;
            status(final ? `Quick estimate shown · confirming on all ${total}… ${done}/${total}` : `Scoring on ${total} photos… ${done}/${total}`);
          },
          onQuick: (r) => show(r),
          onFull: (r) => {
            const summary = show(r);
            if (r.previews) tiles.update(r.previews, native.previews);
            status(r.ran === 0
              ? `Scored on all ${r.n} photos · this recipe's detections were kept from earlier in this visit`
              : `Scored on all ${r.n} photos · ${secs(r.ms.quantize)} to round the weights, ${secs(r.ms.infer)} to score`, "ok");
            announce(summary);
            record(r, label);
          },
          onError: (message) => {
            bar.style.width = "0";
            $("metrics").classList.add("estimate");
            status(`Scoring failed (${message}). The numbers below are from the last run that finished. Change the recipe to try again, or reload the page.`, "error");
            announce(`Scoring failed: ${message}`);
          },
        });
      });

      const nativeShown: Shown = { ap: native.ap, nativeAp: native.ap, cost: native.cost, n: ready.n, final: true };
      const summary = show(nativeShown);
      record(nativeShown, describe(nativeRecipe()));
      status(`Scored native YOLOv8n on all ${ready.n} photos in ${(ready.ms / 1000).toFixed(1)} s · ready`, "ok");

      reset.addEventListener("click", () => { editor.load(nativeRecipe()); reset.disabled = true; editor.focusFirst(); });
      clear.disabled = false;
      clear.addEventListener("click", () => { runs = current ? [current] : []; save(); drawRuns(); });

      // ?preset=<id> loads a preset as if its button were pressed; unknown ids are ignored.
      const wanted = new URLSearchParams(location.search).get("preset");
      if (!(wanted && editor.loadPreset(wanted))) announce(`Ready. ${summary}`);
    }
  </script>
</Base>
