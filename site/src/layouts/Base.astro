---
import "../styles/tokens.css";
export type Section = "school" | "coop" | "guide" | "results";
interface Props { title: string; description?: string; active?: Section }
const { title, description = "Learn model compression by shrinking a real bird-spotting model.", active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const nav: [Section, string, string][] = [
  ["school", "Flight School", "school/"],
  ["coop", "The Coop", "coop/"],
  ["guide", "Field Guide", "guide/"],
  ["results", "Results", "results/"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <!-- Apply a remembered theme before first paint, so a dark choice never flashes light. -->
    <script is:inline>
      try { const t = localStorage.getItem("pigeon.theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={base}><span class="wordmark">Pigeon</span><span class="latin">Columba compressa</span></a>
      <nav aria-label="Sections">
        {nav.map(([key, label, href]) => (
          <a href={`${base}${href}`} aria-current={active === key ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <label class="theme">
        <span>Theme</span>
        <select id="theme">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
    </header>
    <slot />
    <style>
      .skip {
        position: absolute; left: var(--space-2); top: -60px; z-index: 10; padding: var(--space-2) var(--space-3);
        background: var(--ink); color: var(--paper); border-radius: var(--radius);
      }
      .skip:focus { top: var(--space-2); }
      .top {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-5);
        padding-inline: var(--gutter); padding-block: var(--space-3); border-bottom: 1px solid var(--rule);
      }
      .brand { display: flex; align-items: baseline; gap: var(--space-2); text-decoration: none; color: var(--ink); }
      .wordmark { font-family: var(--display); font-weight: 600; font-size: var(--step-2); }
      .latin { font-family: var(--display); font-style: italic; color: var(--magenta); }
      nav { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); margin-inline-end: auto; }
      nav a {
        color: var(--muted); text-decoration: none; font-size: var(--step-0);
        display: inline-flex; align-items: center; min-height: 36px; border-bottom: 2px solid transparent;
      }
      nav a:hover { color: var(--ink); }
      nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--teal); }
      .theme { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--step--1); color: var(--muted); }
      .theme select {
        min-height: 36px; padding: 0 var(--space-2); border: 1px solid var(--rule-strong); border-radius: var(--radius);
        background: var(--card); color: var(--ink);
      }
      @media (pointer: coarse), (max-width: 640px) {
        .brand { padding-block: var(--space-1); }
        nav a, .theme select { min-height: var(--tap); }
      }
      /* Phones: brand and theme share the first row, the nav takes its own full-width row and wraps. */
      @media (max-width: 640px) {
        .top { gap: var(--space-1) var(--space-4); }
        nav { order: 3; flex-basis: 100%; gap: 0 var(--space-4); }
      }
    </style>
    <script>
      const select = document.getElementById("theme") as HTMLSelectElement;
      const KEY = "pigeon.theme";
      let stored: string | null = null;
      try { stored = localStorage.getItem(KEY); } catch {}
      select.value = stored === "light" || stored === "dark" ? stored : "system";
      select.addEventListener("change", () => {
        const v = select.value;
        if (v === "system") delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = v;
        try { v === "system" ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, v); } catch {}
      });
    </script>
  </body>
</html>
